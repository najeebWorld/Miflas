<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>דוח חודשי · {{ c.client.business_name }} · {{ c.month_label }}</title>
<style>
  :root {
    color-scheme: light;
    --page: #f4f3ef;
    --surface: #fcfcfb;
    --line: #e4e2dc;
    --line-strong: #c9c7bf;
    --ink: #16181d;
    --ink-2: #4c4f57;
    --ink-3: #777a82;
    --accent: #1d3557;
    --series-income: #2a78d6;
    --series-expenses: #eb6834;
    --good: #0b6b2e;
    --bad: #b3261e;
    --sev-red: #d03b3b;
    --sev-red-bg: #fbeceb;
    --sev-orange: #d9772b;
    --sev-orange-bg: #fdf1e6;
    --sev-info: #5b6472;
    --sev-info-bg: #eef0f3;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: "Noto Sans Hebrew", "Heebo", "Assistant", "Segoe UI", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.5;
  }
  .sheet {
    max-width: 820px;
    margin: 24px auto;
    padding: 36px 40px 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    position: relative;
  }
  .num { font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; }

  /* ---- header ---- */
  .masthead {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 24px;
    padding-bottom: 18px; border-bottom: 2px solid var(--accent);
  }
  .eyebrow { color: var(--ink-3); font-size: 13px; letter-spacing: .02em; }
  h1 { margin: 2px 0 4px; font-size: 26px; line-height: 1.25; color: var(--accent); }
  .period { font-size: 17px; color: var(--ink-2); }
  .meta { text-align: left; color: var(--ink-3); font-size: 12.5px; white-space: nowrap; }
  .meta div + div { margin-top: 2px; }
  .chip {
    display: inline-block; margin-bottom: 6px; padding: 3px 11px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600; border: 1px solid;
  }
  .chip-needs_review { color: #8a4a0f; background: var(--sev-orange-bg); border-color: #f0c9a3; }
  .chip-ready { color: var(--good); background: #e9f5ec; border-color: #b9dfc3; }
  .chip-reviewed { color: var(--accent); background: #e8eef6; border-color: #b9c9de; }

  .stamp {
    position: fixed; top: 42%; left: 50%; transform: translate(-50%, -50%) rotate(-24deg);
    font-size: 120px; font-weight: 800; letter-spacing: .08em;
    color: rgba(179, 38, 30, .08); pointer-events: none; user-select: none; z-index: 5;
  }
  .draft-note {
    margin: 16px 0 0; padding: 9px 14px; border: 1px dashed #d9a6a2; border-radius: 6px;
    background: #fdf5f4; color: #8c1d18; font-size: 13.5px;
  }

  h2 { margin: 30px 0 12px; font-size: 16px; color: var(--accent); }
  section { position: relative; z-index: 1; }

  /* ---- notices ---- */
  .notices { margin: 18px 0 0; padding: 12px 16px; border: 1px solid #f0c9a3; border-radius: 6px; background: var(--sev-orange-bg); }
  .notices strong { display: block; margin-bottom: 4px; color: #8a4a0f; }
  .notices ul { margin: 0; padding-inline-start: 18px; color: var(--ink-2); font-size: 13.5px; }

  /* ---- KPI cards ---- */
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
  .kpi { padding: 14px 16px 13px; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  .kpi-label { color: var(--ink-2); font-size: 13.5px; }
  .kpi-value { margin: 2px 0 6px; font-size: 28px; font-weight: 700; line-height: 1.15; text-align: right; }
  .kpi-change { font-size: 13px; color: var(--ink-2); }
  .kpi-change .arrow { font-size: 11px; margin-inline-end: 2px; }
  .tone-good .arrow, .tone-good .delta { color: var(--good); }
  .tone-bad .arrow, .tone-bad .delta { color: var(--bad); }
  .delta { font-weight: 600; }
  .kpi-foot { margin-top: 5px; padding-top: 5px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--ink-3); }

  /* ---- chart ---- */
  .panel { padding: 14px 16px 10px; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  .legend { display: flex; gap: 18px; font-size: 13px; color: var(--ink-2); margin-bottom: 2px; }
  .legend span::before {
    content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 2px;
    margin-inline-end: 6px; vertical-align: -1px; background: var(--swatch);
  }
  .chart { display: block; width: 100%; height: auto; }
  .chart .bar-income { fill: var(--series-income); }
  .chart .bar-expenses { fill: var(--series-expenses); }
  .chart .grid { stroke: var(--line); stroke-width: 1; }
  .chart .axis-zero { stroke: var(--line-strong); stroke-width: 1; }
  .chart text { font-family: inherit; fill: var(--ink-3); font-size: 11px; }
  .chart .tick { font-variant-numeric: tabular-nums; }
  .chart .month { fill: var(--ink-2); font-size: 12px; }
  .chart .month-current { fill: var(--ink); font-weight: 700; }

  table.months { width: 100%; margin-top: 8px; border-collapse: collapse; font-size: 12.5px; }
  table.months th, table.months td { padding: 5px 6px; border-top: 1px solid var(--line); text-align: left; }
  table.months th:first-child, table.months td:first-child { text-align: right; }
  table.months thead th { border-top: 0; color: var(--ink-3); font-weight: 500; }
  table.months tbody tr:last-child td { font-weight: 700; }

  /* ---- findings ---- */
  .summary-line { margin: -4px 0 12px; color: var(--ink-3); font-size: 13px; }
  .finding {
    display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: start;
    padding: 12px 14px; margin-bottom: 9px; border: 1px solid var(--line);
    border-inline-start: 4px solid var(--sev); border-radius: 6px; background: #fff;
    break-inside: avoid;
  }
  .finding-red { --sev: var(--sev-red); --sev-bg: var(--sev-red-bg); }
  .finding-orange { --sev: var(--sev-orange); --sev-bg: var(--sev-orange-bg); }
  .finding-info { --sev: var(--sev-info); --sev-bg: var(--sev-info-bg); }
  .badge {
    display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 4px;
    background: var(--sev-bg); color: var(--ink); font-size: 12px; font-weight: 600; white-space: nowrap;
  }
  .badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--sev); flex: none; }
  .finding h3 { margin: 0 0 2px; font-size: 14.5px; }
  .finding p { margin: 0; color: var(--ink-2); font-size: 14px; }
  .calm { padding: 14px 16px; border: 1px solid #b9dfc3; border-radius: 6px; background: #f1f9f3; color: var(--good); }

  footer {
    margin-top: 30px; padding-top: 12px; border-top: 1px solid var(--line);
    color: var(--ink-3); font-size: 12.5px; text-align: center; position: relative; z-index: 1;
  }

  @media (max-width: 640px) {
    .sheet { margin: 0; padding: 22px 16px; border: 0; border-radius: 0; }
    .masthead { flex-direction: column; gap: 10px; }
    .meta { text-align: right; }
    .kpis { grid-template-columns: 1fr; }
    .finding { grid-template-columns: 1fr; gap: 6px; }
    .panel { overflow-x: auto; }
    .chart, table.months { min-width: 520px; }
  }
  @page { size: A4; margin: 14mm 12mm; }
  @media print {
    body { background: #fff; font-size: 13px; }
    .sheet { max-width: none; margin: 0; padding: 0; border: 0; background: #fff; }
    h2 { break-after: avoid; }
    .panel, .kpis { break-inside: avoid; }
  }
</style>
</head>
<body>
{% if not reviewed %}
<div class="stamp" aria-hidden="true">טיוטה</div>
{% endif %}
<main class="sheet">
  <header class="masthead">
    <div>
      <div class="eyebrow">דוח חודשי ללקוח</div>
      <h1>{{ c.client.business_name }}</h1>
      <div class="period">{{ c.month_label }}</div>
    </div>
    <div class="meta">
      {% if reviewed %}
      <span class="chip chip-reviewed">נסקר על ידי רו"ח{% if reviewed_at_text %} · <span class="num">{{ reviewed_at_text }}</span>{% endif %}</span>
      {% else %}
      <span class="chip chip-{{ c.status }}">{{ status_label }}</span>
      {% endif %}
      <div>ע.מ. <span class="num">{{ c.client.vat_id }}</span></div>
      {% if c.client.tax_year %}<div>שנת מס <span class="num">{{ c.client.tax_year }}</span></div>{% endif %}
      <div>הופק <span class="num">{{ generated_at_text }}</span></div>
    </div>
  </header>

  {% if not reviewed %}
  <p class="draft-note">טיוטה — הדוח טרם נסקר ואושר על ידי רו"ח.</p>
  {% endif %}

  {% if c.warnings %}
  <section class="notices">
    <strong>הערות על איכות הנתונים</strong>
    <ul>
      {% for w in c.warnings %}
      <li>{{ w | figures }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="kpis" aria-label="מדדים עיקריים">
    {% for k in c.kpis %}
    <div class="kpi">
      <div class="kpi-label">{{ k.label }}</div>
      <div class="kpi-value"><span class="num">{{ k.value_text }}</span></div>
      {% if k.change %}
      <div class="kpi-change tone-{{ k.change.tone }}">
        {% if k.change.direction == "up" %}<span class="arrow">▲</span>{% elif k.change.direction == "down" %}<span class="arrow">▼</span>{% endif %}
        <span class="delta num">{{ k.change.diff_text }}</span>
        {% if k.change.pct_text %}(<span class="num">{{ k.change.pct_text }}</span>){% endif %}
        מול {{ c.previous_label }}
      </div>
      {% else %}
      <div class="kpi-change">אין חודש קודם להשוואה</div>
      {% endif %}
      {% if k.key == "profit" %}
      <div class="kpi-foot">שיעור רווח: <span class="num">{{ c.margin_text }}</span></div>
      {% endif %}
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>הכנסות מול הוצאות</h2>
    <div class="panel">
      <div class="legend">
        <span style="--swatch: var(--series-income)">הכנסות</span>
        <span style="--swatch: var(--series-expenses)">הוצאות</span>
      </div>
      {{ chart }}
      <table class="months">
        <thead>
          <tr><th>חודש</th><th>הכנסות</th><th>הוצאות</th><th>רווח תפעולי</th><th>שיעור רווח</th></tr>
        </thead>
        <tbody>
          {% for m in c.series %}
          <tr>
            <td>{{ m.month_label }}</td>
            <td><span class="num">{{ m.income_text }}</span></td>
            <td><span class="num">{{ m.expenses_text }}</span></td>
            <td><span class="num">{{ m.profit_text }}</span></td>
            <td><span class="num">{{ m.margin_text }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>חריגות וממצאים</h2>
    {% if c.findings %}
    <p class="summary-line">
      {% set parts = [] %}
      {% if c.severity_counts.red %}{% set _ = parts.append(c.severity_counts.red ~ " מהותיות") %}{% endif %}
      {% if c.severity_counts.orange %}{% set _ = parts.append(c.severity_counts.orange ~ " לבדיקה") %}{% endif %}
      {% if c.severity_counts.info %}{% set _ = parts.append(c.severity_counts.info ~ " למידע") %}{% endif %}
      {{ parts | join(" · ") }}
    </p>
    {% for f in c.findings %}
    <article class="finding finding-{{ f.severity }}">
      <div><span class="badge"><i></i>{{ f.severity_label }}</span></div>
      <div>
        <h3>{{ f.title }}</h3>
        <p>{{ f.text | figures }}</p>
      </div>
    </article>
    {% endfor %}
    {% else %}
    <p class="calm">לא זוהו חריגות החודש.</p>
    {% endif %}
  </section>

  <footer>נוצר אוטומטית · לבדיקת רו"ח לפני שליחה ללקוח</footer>
</main>
</body>
</html>
