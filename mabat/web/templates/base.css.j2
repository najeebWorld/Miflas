  :root {
    color-scheme: light;
    --page: #f4f3ef; --surface: #fcfcfb; --line: #e4e2dc; --line-strong: #c9c7bf;
    --ink: #16181d; --ink-2: #4c4f57; --ink-3: #777a82; --accent: #1d3557;
    --good: #0b6b2e; --bad: #b3261e;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--page); color: var(--ink);
    font-family: "Noto Sans Hebrew", "Heebo", "Assistant", "Segoe UI", Arial, sans-serif;
    font-size: 15px; line-height: 1.5;
  }
  a { color: var(--accent); }
  .num { font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; }
  .topbar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 12px 24px; background: var(--accent); color: #fff;
  }
  .brand { font-size: 19px; font-weight: 700; }
  .brand small { margin-inline-start: 10px; font-size: 13px; font-weight: 400; opacity: .8; }
  .chip {
    display: inline-block; padding: 2px 10px; border-radius: 999px; border: 1px solid;
    font-size: 12.5px; font-weight: 600; white-space: nowrap;
  }
  .chip-needs_review { color: #8a4a0f; background: #fdf1e6; border-color: #f0c9a3; }
  .chip-ready { color: var(--good); background: #e9f5ec; border-color: #b9dfc3; }
  .chip-reviewed { color: var(--accent); background: #e8eef6; border-color: #b9c9de; }
  .chip-pending { color: var(--ink-2); background: #f0efeb; border-color: var(--line-strong); }
  .btn {
    display: inline-block; padding: 7px 16px; border-radius: 6px; border: 1px solid var(--accent);
    background: var(--accent); color: #fff; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer;
  }
  .btn-quiet { background: #fff; color: var(--accent); }
  .btn:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid #2a78d6; outline-offset: 2px; }
